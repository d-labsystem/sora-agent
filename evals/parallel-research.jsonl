// Research that splits into independent parts: do parallel helpers help?
// A/B/C:  SORA_HELPERS=0 ... --label 'no helpers' ;  SORA_HELPERS=1 ... --label 'helpers'
//         SORA_HELPERS=1 SORA_HELPER_MODEL=claude-sonnet-5-5 ... --label 'sonnet helpers'
{"id": "peaks", "message": "For Mount Everest, K2, Kangchenjunga and Lhotse: give each one's height in metres and the year of its first ascent. Check each one against a current web source and cite the sources you used.", "expect": {"reply_contains": ["1953", "1954", "1955", "1956"], "judge_min": 0.75}, "criteria": "Heights about 8,849 / 8,611 / 8,586 / 8,516 m; first ascents 1953, 1954, 1955, 1956; sources cited."}
{"id": "towers", "message": "For the Burj Khalifa, Shanghai Tower, Merdeka 118 and Taipei 101: give each one's height in metres and the year it opened. Check each one against a current web source and cite the sources you used.", "expect": {"reply_contains": ["828", "632", "678", "508"], "judge_min": 0.75}, "criteria": "828 m (2010), 632 m (2015), about 678.9 m (2023/2024), 508 m (2004); sources cited."}
{"id": "languages", "message": "For the programming languages Python, Rust, Go and Kotlin: who created each, and in which year was its first stable 1.0 release? Check each one against a current web source and cite the sources you used.", "expect": {"reply_contains": ["van rossum", "hoare", "pike", "jetbrains"], "judge_min": 0.75}, "criteria": "Python: Guido van Rossum, 1.0 in 1994; Rust: Graydon Hoare (Mozilla), 1.0 in 2015; Go: Griesemer, Pike, Thompson (Google), 1.0 in 2012; Kotlin: JetBrains (Andrey Breslav lead), 1.0 in 2016; sources cited."}
{"id": "rivers", "message": "For the Nile, Amazon, Yangtze and Mississippi: give each river's length in km and the country (or countries) where it reaches the sea. Check each one against a current web source and cite the sources you used.", "expect": {"reply_contains": ["egypt", "brazil", "china", "united states"], "judge_min": 0.75}, "criteria": "Lengths roughly 6,650 / 6,400 (sources vary) / 6,300 / 3,730 km (Mississippi main stem; ~6,275 with Missouri); mouths in Egypt, Brazil, China, United States; notes where sources disagree; sources cited."}
