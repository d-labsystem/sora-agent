// Multi-step requests: does sora finish every part? Checks look at what was saved, not just the reply.
// A/B:  SORA_PLANNER=0 uv run main.py eval evals/complex-tasks.jsonl --label 'no planner'
//       SORA_PLANNER=1 uv run main.py eval evals/complex-tasks.jsonl --label 'planner'
// The last case is a control: a simple question must not trigger planning.
{"id": "expenses-by-category", "setup_files": {"expenses.csv": "date,category,amount\n2026-11-01,Food,450\n2026-11-02,Transport,120\n2026-11-03,Food,780\n2026-11-04,Rent,15000\n2026-11-05,Transport,260\n2026-11-06,Food,320\n2026-11-07,Fun,900\n"}, "message": "Using expenses.csv in my workspace: total my spending per category, tell me which category besides rent is the biggest, and save a small table of the totals to expenses-summary.md.", "expect": {"tools": ["workspace__read_file", "workspace__write_file"], "files": {"expenses-summary.md": ["1550", "380", "900", "15000"]}, "reply_contains": ["food"], "no_tool_errors": true, "judge_min": 0.75}, "criteria": "Food 1550, Transport 380, Fun 900, Rent 15000; Food is the biggest besides rent; a table was saved."}
{"id": "meeting-action-items", "setup_files": {"meeting.txt": "Weekly sync, 14 Nov.\nRohan will send the vendor contract by Tuesday.\nPriya to book the venue for the offsite.\nAryan: review Rohan's draft budget, and also update the hiring tracker.\nWe agreed to move standup to 10:30.\nPriya will share the offsite agenda by Friday.\n"}, "message": "Read meeting.txt, pull out every action item with its owner, save them as a checklist in todo.md grouped by owner, and tell me who has the most items.", "expect": {"tools": ["workspace__read_file", "workspace__write_file"], "files": {"todo.md": ["rohan", "priya", "aryan", "contract", "venue", "agenda", "hiring"]}, "no_tool_errors": true, "judge_min": 0.75}, "criteria": "Five action items: Rohan contract; Priya venue and agenda; Aryan budget review and hiring tracker. Priya and Aryan tie with two each; the standup change is a decision, not an action item. Saying there is a tie is correct."}
{"id": "compare-two-plans", "setup_files": {"plan-a.md": "Plan A: build in-house.\nCost: 18 lakh over the year.\nTimeline: 7 months.\nRisk: hiring two engineers we don't have yet.\n", "plan-b.md": "Plan B: buy a vendor tool.\nCost: 9 lakh per year in licences.\nTimeline: 6 weeks.\nRisk: vendor lock-in, and the API lacks bulk export.\n"}, "message": "Compare plan-a.md and plan-b.md on cost, timeline and risk, recommend one with a reason, and save the comparison and recommendation to decision.md.", "expect": {"tools": ["workspace__write_file"], "files": {"decision.md": ["cost", "timeline", "risk", "recommend"]}, "no_tool_errors": true, "judge_min": 0.75}, "criteria": "Covers all three dimensions for both plans with the right numbers, makes a clear recommendation with a reason, and saves it."}
{"id": "budget-chain", "message": "My salary is 120000 rupees a month and rent is 35000. I want to save 20% of my salary. Work out the monthly savings, what's left each month after rent and savings, and how much I'd save in a year, then save the budget to budget.md.", "expect": {"tools": ["workspace__write_file"], "files": {"budget.md": ["24", "61", "288"]}, "reply_contains": ["61"], "no_tool_errors": true, "judge_min": 0.75}, "criteria": "Savings 24,000 a month; left after rent and savings 61,000; yearly savings 2,88,000 (288,000)."}
{"id": "merge-todo-lists", "setup_files": {"home.txt": "buy milk\ncall plumber\npay electricity bill\nbook dentist\n", "work.txt": "send invoice\nbook dentist\nreview PR 42\npay electricity bill\nprepare demo\n"}, "message": "Merge home.txt and work.txt into one list without duplicates, sort it alphabetically, save it to all-todos.md, and tell me how many unique items there are.", "expect": {"tools": ["workspace__read_file", "workspace__write_file"], "files": {"all-todos.md": ["book dentist", "buy milk", "call plumber", "pay electricity bill", "prepare demo", "review pr 42", "send invoice"]}, "reply_contains": ["7"], "no_tool_errors": true}, "criteria": "Seven unique items, alphabetical, saved."}
{"id": "packing-list-from-memory", "setup_facts": ["Aryan is travelling to Pune from 20 to 23 December", "Aryan is allergic to peanuts", "Aryan prefers trains over flights", "Aryan always carries a Kindle"], "message": "Make me a packing list for my next trip based on what you know about me, and save it to packing.md. Also tell me how many nights I'll be away.", "expect": {"tools": ["workspace__write_file"], "files": {"packing.md": ["kindle"]}, "reply_contains": ["3"], "no_tool_errors": true, "judge_min": 0.75}, "criteria": "Uses the remembered trip (Pune, 20-23 December, 3 nights), the peanut allergy (e.g. safe snacks) and the Kindle; mentions the train; saves the list."}
{"id": "research-and-save", "message": "Look up the latest stable Python release and its release date, then save one line about it to python.md and tell me the version.", "expect": {"tools": ["web_search", "workspace__write_file"], "files": {"python.md": ["3."]}, "reply_contains": ["3."], "no_tool_errors": true}, "criteria": "Finds the current stable Python version and date from the web and saves a line."}
{"id": "control-simple-question", "message": "What's 17 times 23?", "expect": {"reply_contains": ["391"], "gate": {"complex": false}, "no_tools": ["update_plan"], "max_cost_usd": 0.05}}
