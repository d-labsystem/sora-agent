ANTHROPIC_API_KEY=
# Optional overrides
# SORA_MODEL=claude-opus-5-5
# SORA_SMALL_MODEL=claude-haiku-5-5
# Other providers: prefix the model name (install with: uv sync --extra providers).
#   openai:gpt-5.1           needs OPENAI_API_KEY
#   hf:Qwen/Qwen3-32B        needs HF_TOKEN (Hugging Face Inference Providers)
#   local:my-model           needs SORA_LOCAL_BASE_URL, e.g. http://127.0.0.1:8000/v1 (vLLM, SGLang)
# Web search runs on Anthropic and OpenAI (Responses API); not on hf: or local: models.
# Run code in the provider's sandbox (Anthropic code_execution, OpenAI code_interpreter):
# SORA_CODE_EXECUTION=1
# OPENAI_API_KEY=
# HF_TOKEN=
# SORA_LOCAL_BASE_URL=
# Prices for non-Anthropic models, $ per million tokens [input, output]:
# SORA_PRICES={"gpt-5.1": [1.25, 10.0]}
# SORA_HOME=~/.sora
# Web research limits, per model call (0 = no limit). Lower = cheaper, less thorough.
# SORA_WEB_MAX_SEARCHES=8
# SORA_WEB_MAX_FETCHES=4
# SORA_WEB_FETCH_MAX_TOKENS=20000
# Memory search by meaning (local embedding model, ~70 MB downloaded once). 0 = words only.
# SORA_EMBEDDINGS=1
# SORA_MEMORY_MIN_SIMILARITY=0.45

# Where facts and episodes live (sessions and messages always stay in memory.db):
#   sqlite (default) | pgvector | langgraph      see memory/backends/
# Postgres for the other two, e.g. with Docker:
#   docker run -d --name sora-pg -p 5433:5432 -e POSTGRES_PASSWORD=sora \
#     -v sora-pg-data:/var/lib/postgresql/data pgvector/pgvector:pg17
#   uv sync --extra memory-pg        (pgvector)   or   --extra memory-langmem   (langgraph, LangMem)
# Copy what you have first:  uv run main.py memory migrate --to pgvector
# SORA_MEMORY=sqlite
# SORA_DATABASE_URL=postgresql://postgres:sora@localhost:5433/postgres
# Who turns chat into facts: sora (adds only) | langmem (adds, rewrites and deletes; needs SORA_MEMORY=langgraph)
# SORA_CONSOLIDATOR=sora
# A readable copy of memory at <home>/MEMORY.md, rewritten after each change (one way: edits aren't read back)
# SORA_MEMORY_MIRROR=1
# Long tasks (ask --long, the dashboard's Long task toggle, "long": true in eval cases):
# SORA_LONG_ITERATIONS=60
# SORA_LONG_BUDGET_USD=2.0
# Summarize a turn's context when it passes this many tokens (any turn; 0 = never):
# SORA_COMPACT_AT=150000
