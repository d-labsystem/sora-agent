ANTHROPIC_API_KEY=
# Optional overrides
# SORA_MODEL=claude-opus-5-5
# SORA_SMALL_MODEL=claude-haiku-5-5
# Other providers: prefix the model name (install with: uv sync --extra providers).
#   openai:gpt-5.1           needs OPENAI_API_KEY
#   hf:Qwen/Qwen3-32B        needs HF_TOKEN (Hugging Face Inference Providers)
#   local:my-model           needs SORA_LOCAL_BASE_URL, e.g. http://127.0.0.1:8000/v1 (vLLM, SGLang)
# Web search runs on Anthropic and OpenAI (Responses API); not on hf: or local: models.
# Run code in the provider's sandbox (Anthropic code_execution, OpenAI code_interpreter):
# SORA_CODE_EXECUTION=1
# OPENAI_API_KEY=
# HF_TOKEN=
# SORA_LOCAL_BASE_URL=
# Prices for non-Anthropic models, $ per million tokens [input, output]:
# SORA_PRICES={"gpt-5.1": [1.25, 10.0]}
# SORA_HOME=~/.sora
# Web research limits, per model call (0 = no limit). Lower = cheaper, less thorough.
# SORA_WEB_MAX_SEARCHES=8
# SORA_WEB_MAX_FETCHES=4
# SORA_WEB_FETCH_MAX_TOKENS=20000
# Memory search by meaning (local embedding model, ~70 MB downloaded once). 0 = words only.
# SORA_EMBEDDINGS=1
# SORA_MEMORY_MIN_SIMILARITY=0.45

# Where facts and episodes live (sessions and messages always stay in memory.db):
#   sqlite (default) | pgvector | langgraph      see memory/backends/
# Postgres for the other two, e.g. with Docker:
#   docker run -d --name sora-pg -p 5433:5432 -e POSTGRES_PASSWORD=sora \
#     -v sora-pg-data:/var/lib/postgresql/data pgvector/pgvector:pg17
#   uv sync --extra memory-pg        (pgvector)   or   --extra memory-langmem   (langgraph, LangMem)
# Copy what you have first:  uv run main.py memory migrate --to pgvector
# SORA_MEMORY=sqlite
# SORA_DATABASE_URL=postgresql://postgres:sora@localhost:5433/postgres
# Who turns chat into facts: sora (adds only) | langmem (adds, rewrites and deletes; needs SORA_MEMORY=langgraph)
# SORA_CONSOLIDATOR=sora
# A readable copy of memory at <home>/MEMORY.md, rewritten after each change (one way: edits aren't read back)
# SORA_MEMORY_MIRROR=1
# Long tasks (ask --long, the dashboard's Long task toggle, "long": true in eval cases):
# SORA_LONG_ITERATIONS=60
# SORA_LONG_BUDGET_USD=2.0
# Summarize a turn's context when it passes this many tokens (any turn; 0 = never):
# SORA_COMPACT_AT=150000

# OpenTelemetry: a copy of every finished turn, sent to trace viewers (ops/otel.py).
# Off unless a destination is set. Needs: uv sync --extra otel
# Phoenix, local (bound to localhost; sign-in off because only this Mac can reach it):
#   docker run -d --name sora-phoenix -p 127.0.0.1:6006:6006 -v sora-phoenix-data:/mnt/data \
#     -e PHOENIX_WORKING_DIR=/mnt/data -e PHOENIX_ENABLE_AUTH=false -e PHOENIX_TELEMETRY_ENABLED=false \
#     arizephoenix/phoenix:latest
# SORA_PHOENIX_ENDPOINT=http://localhost:6006
# SORA_PHOENIX_API_KEY=            # only if your Phoenix has sign-in on
# Langfuse (cloud.langfuse.com > project > Settings > API keys), or self-hosted:
# LANGFUSE_PUBLIC_KEY=pk-lf-129f186d-7f2e-45a2-8005-789fb57d02ef
# LANGFUSE_SECRET_KEY=sk-lf-46f61f2f-778b-46ab-83ba-461782fa5c8b
# LANGFUSE_HOST=https://cloud.langfuse.com      (or LANGFUSE_BASE_URL; US: https://us.cloud.langfuse.com)
# Message and reply text: by default sent to localhost endpoints only. 1 = everywhere, 0 = nowhere
# SORA_OTEL_CONTENT=
# Send old turns:  uv run main.py export --otel --since 2026-11-01

# WhatsApp (harness/whatsapp.py). `serve` starts it next to the dashboard; `whatsapp` runs it alone.
# The webhook listens on 127.0.0.1:8766; expose ONLY it with a tunnel:
#   cloudflared tunnel --url http://localhost:8766      -> paste https://<...>.trycloudflare.com/whatsapp
# SORA_WHATSAPP_ALLOWED=+919800000000            # numbers allowed to talk to sora (comma-separated)
# SORA_WHATSAPP_PROVIDER=twilio                  # twilio | meta (default: whichever has credentials)
# Twilio sandbox: Console > Messaging > Try it out > Send a WhatsApp message; send "join <code>" from your phone
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# SORA_WHATSAPP_FROM=whatsapp:+14155238886       # the sandbox number
# Meta Cloud API (needs an unlocked, verified WhatsApp Business Account):
# WHATSAPP_ACCESS_TOKEN=EAA...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_APP_SECRET=...
# SORA_WHATSAPP_VERIFY_TOKEN=any-random-string   # typed into Meta's webhook form too

# Permission rules live in <home>/permissions.json (written with safe defaults on first run).
# See what every tool may do:   uv run main.py permissions
# Test one call:                uv run main.py permissions test gcal__create_event '{"attendees": ["a@x.com"]}'

# A real browser (tools/browser_server.py): sora's own profile in <home>/browser, never your Chrome profile.
# uv sync --extra browser ; uv run main.py browser check ; sign in to a site: uv run main.py browser login <url>
# SORA_BROWSER=1
# SORA_BROWSER_ENGINE=auto      # auto (Playwright's Chromium, else installed Chrome) | chrome | chromium
